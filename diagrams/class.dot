digraph C {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.5];
node [shape=record, style="filled", fontname="Times New Roman", fontsize=10, color="#2F5597", fillcolor="#F7FBFF"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
ch [label="{«interface» NotificationChannel||+ supports(NotificationRequest) boolean\l+ send(NotificationRequest) NotificationResult\l}"];
em [label="{EmailChannel||+ supports(NotificationRequest) boolean\l+ send(NotificationRequest) NotificationResult\l}"];
sms [label="{SmsChannel||+ supports(NotificationRequest) boolean\l+ send(NotificationRequest) NotificationResult\l}"];
in [label="{InternalChannel||+ supports(NotificationRequest) boolean\l+ send(NotificationRequest) NotificationResult\l}"];
push [label="{PushChannel|+ MAX_LENGTH = 25 int\l|+ supports(NotificationRequest) boolean\l+ send(NotificationRequest) NotificationResult\l}"];
f [label="{ChannelFactory|- channels Map[ChannelType,NotificationChannel]\l|+ ChannelFactory()\l+ ChannelFactory(Map[ChannelType,NotificationChannel])\l+ get(ChannelType) NotificationChannel\l}"];
s [label="{NotificationService|- factory ChannelFactory\l|+ NotificationService(ChannelFactory)\l+ notify(NotificationRequest) NotificationResult\l}"];
rq [label="{«record» NotificationRequest|- type ChannelType\l- recipient String\l- message String\l}"];
rs [label="{«record» NotificationResult|- success boolean\l- details String\l}"];
t [label="{«enum» ChannelType|EMAIL\lSMS\lINTERNAL\lPUSH\l}"];
ch -> em [label="implements",dir=back,arrowtail=empty,arrowhead=none,style=dashed];
ch -> sms [label="implements",dir=back,arrowtail=empty,arrowhead=none,style=dashed];
ch -> in [label="implements",dir=back,arrowtail=empty,arrowhead=none,style=dashed];
ch -> push [label="implements",dir=back,arrowtail=empty,arrowhead=none,style=dashed];
f -> ch [label="creates",style=dashed,arrowhead=open];
s -> f [label="1 (через конструктор)",arrowtail=odiamond,dir=both];
s -> rq [label="uses",style=dashed,arrowhead=open];
s -> rs [label="returns",style=dashed,arrowhead=open];
rq -> t [label="1",style=dashed,arrowhead=open];
em -> in [style=invis];
sms -> push [style=invis];
}
